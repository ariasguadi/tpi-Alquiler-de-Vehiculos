# ---------------------------------------------------------------------------
# Makefile del proyecto SistemaAlquiler.dev para Embarcadero Dev-C++.
# Compila solamente la aplicacion principal (sistema.exe) con C99.
# ---------------------------------------------------------------------------

CC       = C:/PROGRA~2/Embarcadero/Dev-Cpp/TDM-GCC-64/bin/gcc.exe
CFLAGS   = -std=c99 -Wall -Wextra -O2

BIN      = sistema.exe
FUENTES  = main.c menu.c fechas.c utils.c clientes.c vehiculos.c \
           alquileres.c movimientos.c reportes.c
CABECERAS = $(wildcard *.h)

.PHONY: all clean

all: $(BIN)

$(BIN): $(FUENTES) $(CABECERAS)
	"$(CC)" $(CFLAGS) -o $@ $(FUENTES)

clean:
	-del /Q $(BIN) 2>NUL
