# ---------------------------------------------------------------------------
# Makefile del proyecto SistemaAlquiler.dev para Embarcadero Dev-C++.
# Compila solamente la aplicacion principal (sistema.exe) con C++11.
# ---------------------------------------------------------------------------

CXX      = C:/PROGRA~2/Embarcadero/Dev-Cpp/TDM-GCC-64/bin/g++.exe
CXXFLAGS = -std=c++11 -Wall -Wextra -O2

BIN      = sistema.exe
FUENTES  = main.cpp menu.cpp fechas.cpp utils.cpp clientes.cpp vehiculos.cpp \
           alquileres.cpp movimientos.cpp reportes.cpp
CABECERAS = $(wildcard *.h)

.PHONY: all clean

all: $(BIN)

$(BIN): $(FUENTES) $(CABECERAS)
	"$(CXX)" $(CXXFLAGS) -o $@ $(FUENTES)

clean:
	-del /Q $(BIN) 2>NUL
